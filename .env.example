# ---- CFRS environment (copy to .env for local dev; set in host dashboard in prod) ----
# Django core
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Database (leave blank for local SQLite; a Postgres URL in production)
DATABASE_URL=

# Email (SMTP) for the 6-digit OTP. Blank EMAIL_HOST/USER => console mode (prints codes).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CFRS <no-reply@cfrs.local>
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_CODES_PER_HOUR=5

# Social login (optional). See DEPLOYMENT.md for the production callback URLs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Seeded admin superuser password (stable across deploys)
CFRS_ADMIN_PASSWORD=
