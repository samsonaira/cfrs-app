# Environment variables read by config/settings.py.
#
# None of these are needed for local development: with nothing set the app
# runs with DEBUG on and accepts requests for localhost only.
#
# Django does not load this file by itself. To use it, copy it to .env
# (which is gitignored - never commit real values), edit it, then export
# the variables into your shell before running manage.py:
#
#     cp .env.example .env
#     set -a; source .env; set +a
#
# On a hosting platform, set the same names in its environment settings.

# "True" for local development. Set to "False" anywhere public.
DJANGO_DEBUG=True

# Required when DJANGO_DEBUG is False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Comma-separated host names the site is served from.
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1,[::1]"
